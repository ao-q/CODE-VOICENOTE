<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_floating_overlay"
    android:elevation="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Status indicator dot (red recording / amber paused) -->
    <ImageView
        android:id="@+id/float_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/ic_float_dot_recording"
        android:contentDescription="@null" />

    <!-- Elapsed timer -->
    <TextView
        android:id="@+id/float_timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="4dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Vertical separator -->
    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#384252" />

    <!-- Flag timestamp button -->
    <ImageButton
        android:id="@+id/float_btn_flag"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_floating_action"
        android:src="@drawable/ic_float_flag"
        android:scaleType="centerInside"
        android:contentDescription="Flag Timestamp" />

    <!-- Pause / Resume button -->
    <ImageButton
        android:id="@+id/float_btn_pause_resume"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_floating_action"
        android:src="@drawable/ic_float_pause"
        android:scaleType="centerInside"
        android:contentDescription="Pause or Resume Recording" />

    <!-- Stop & Save button -->
    <ImageButton
        android:id="@+id/float_btn_stop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_floating_action"
        android:src="@drawable/ic_float_stop"
        android:scaleType="centerInside"
        android:contentDescription="Stop and Save Recording" />

    <!-- Open App button -->
    <ImageButton
        android:id="@+id/float_btn_open"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_floating_action"
        android:src="@drawable/ic_float_open"
        android:scaleType="centerInside"
        android:contentDescription="Open App" />

</LinearLayout>
